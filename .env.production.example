# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - SERVIDOR UBUNTU (APLICACIÓN LARAVEL)
# Copia este archivo como .env en el servidor de la aplicación y rellena los datos
# ==============================================================================

APP_NAME=IkasKude
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://tu-dominio-o-ip.com

# Puerto en el host del servidor Ubuntu donde escuchará Nginx
APP_PORT=80

# Idioma por defecto
APP_LOCALE=eu
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Credenciales para el administrador inicial (al ejecutar db:seed)
INITIAL_ADMIN_EMAIL=admin@ciber.eus
INITIAL_ADMIN_PASSWORD=CambiaEstaContrasenaPorUnaSegura2026!

# Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# ==============================================================================
# CONEXIÓN CON EL SERVIDOR UBUNTU DE BASE DE DATOS (MYSQL REMOTO)
# ==============================================================================
DB_CONNECTION=mysql
# Sustituye por la IP del segundo servidor Ubuntu (idealmente IP privada o local)
DB_HOST=192.168.1.100
DB_PORT=3306
DB_DATABASE=ciber_plataforma
DB_USERNAME=ciber_user
DB_PASSWORD=ContrasenaDelUsuarioMySQL123!

# ==============================================================================
# MIGRACIONES AUTOMÁTICAS
# ==============================================================================
# Si lo pones a true, el contenedor ejecutará 'php artisan migrate --force' cada vez que arranque
AUTORUN_MIGRATIONS=false

# ==============================================================================
# SESIONES, COLAS Y CACHÉ
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ==============================================================================
# CORREO ELECTRÓNICO (Ajustar según proveedor SMTP: Mailgun, SES, etc.)
# ==============================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@ciber.eus"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
